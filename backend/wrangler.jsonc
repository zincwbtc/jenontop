{
  "name": "lootlane-test-backend",
  "main": "worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "powershell -NoProfile -File ../scripts/build-site.ps1" },
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "workers_dev": true,
  // Same-origin API on the real domain: phones/in-app browsers and school filters often block *.workers.dev.
  "routes": [{ "pattern": "lootlaneblox.com/api/*", "zone_name": "lootlaneblox.com" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "ALLOWED_ORIGIN": "https://lootlaneblox.com,https://www.lootlaneblox.com,https://zincwbtc.github.io,https://lootlane-test-backend.brycen0407.workers.dev" },
  "d1_databases": [{ "binding": "DB", "database_name": "lootlane-test", "database_id": "d578c9a3-d046-436d-85b1-bcee05bda169", "migrations_dir": "migrations" }]
}
