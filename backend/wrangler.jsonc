{
  "name": "lootlane-test-backend",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ALLOWED_ORIGIN": "https://YOUR-USERNAME.github.io" },
  "d1_databases": [{ "binding": "DB", "database_name": "lootlane-test", "database_id": "REPLACE-WITH-YOUR-DATABASE-ID", "migrations_dir": "migrations" }]
}
